<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Trust all system certificates and allow cleartext for development -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>

    <!-- Explicitly trust Cloudinary and Vercel domains -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">cloudinary.com</domain>
        <domain includeSubdomains="true">res.cloudinary.com</domain>
        <domain includeSubdomains="true">vercel.app</domain>
        <domain includeSubdomains="true">meetapp-sigma.vercel.app</domain>
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </domain-config>
</network-security-config>
